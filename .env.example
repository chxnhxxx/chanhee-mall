# ─────────────────────────────────────────────────────────────
# chanhee-mall 환경변수 예시
# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요:  cp .env.example .env.local
# .env.local 은 git 에 올라가지 않습니다(.gitignore). 진짜 키는 절대 이 파일에 적지 마세요.
#
# 모든 외부 서비스 키는 "선택"입니다. 비워 두면 해당 기능이 로컬 대체 구현으로 동작합니다.
#   Supabase 없음 → 메모리 DB(데모 상품 24개, 서버 재시작 시 초기화)
#   Toss 없음     → 모의 결제 버튼 (서버 검증 로직은 동일하게 통과)
#   Resend 없음   → 메일 내용을 서버 콘솔에 출력
#   Upstash 없음  → 레이트 리밋·캐시를 서버 메모리로 대체
#   Sentry/GA 없음 → 전송 안 함
# NEXT_PUBLIC_ 로 시작하는 값은 브라우저에 그대로 노출됩니다. 비밀 값에 붙이지 마세요.
# ─────────────────────────────────────────────────────────────

# 사이트 공개 주소 (결제 후 돌아올 주소, 메일 링크). 로컬은 비워도 됨
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 데이터 저장소: auto(기본, Supabase 키 3개가 다 있으면 supabase) | supabase | memory
DATA_BACKEND=auto

# 메모리 모드 로그인 쿠키 서명용 비밀값 (32자 이상). 만들기: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Supabase (Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=
# 새 형식 공개 키: sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 새 형식 비밀 키: sb_secret_... (서버 전용! RLS 를 우회하므로 절대 노출 금지)
SUPABASE_SECRET_KEY=

# ── 토스페이먼츠 (개발자센터 → API 키, 반드시 test_ 로 시작하는 테스트 키) ──
# 결제위젯 연동 키의 클라이언트 키 (test_gck_...)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 결제위젯 연동 키의 시크릿 키 (test_gsk_...)
TOSS_SECRET_KEY=

# ── Resend (주문 확인 메일) ──
RESEND_API_KEY=
# 보내는 사람. 도메인 인증 전에는 onboarding@resend.dev 만 가능 [미확인]
EMAIL_FROM=chanhee-mall <onboarding@resend.dev>
# 도메인 인증 전에는 가입한 본인 주소로만 발송 가능 [미확인] → 모든 메일을 이 주소로 돌려보냄
EMAIL_DEV_REDIRECT_TO=

# ── Upstash Redis (레이트 리밋·캐시) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 1 이면 레이트 리밋 끔 (E2E 테스트용. 운영에서는 비워 두세요)
DISABLE_RATE_LIMIT=

# ── Sentry (에러 추적) ──
NEXT_PUBLIC_SENTRY_DSN=
# 아래 3개는 빌드 때 소스맵 업로드용 (Vercel 환경변수에만 넣으면 됨)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── GA4 (측정 ID: G-XXXXXXXXXX) ──
NEXT_PUBLIC_GA_ID=

# ── 운영 작업 ──
# GitHub Actions 깨우기 핑·만료 주문 정리·메일 재시도 API 를 부를 때 쓰는 비밀 토큰 (32자 이상 무작위)
CRON_SECRET=
# 1 이면 CSP 를 "보고만"(Report-Only)에서 "실제 차단"으로 전환. 보고된 위반이 없을 때 켜세요
CSP_ENFORCE=
